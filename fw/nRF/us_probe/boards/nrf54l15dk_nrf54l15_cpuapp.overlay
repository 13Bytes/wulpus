/ {
    aliases {
        data-ready = &data_ready_pin;
        ble-cnfg-ready = &ble_cnfg_ready_pin;
        spi-conn = &spi20;
        spi-ss = &spi_ss_pin;
        i2c = &npm2100;
        pmic = &npm2100;
    };

    /*chosen {
        // Override default console/shell to use UART30 instead of UART20
        // This allows SPI20 to be used without conflict
        zephyr,console = &uart30;
        zephyr,shell-uart = &uart30;
        zephyr,uart-mcumgr = &uart30;
        zephyr,bt-mon-uart = &uart30;
        zephyr,bt-c2h-uart = &uart30;
        nordic,nus-uart = &uart30;
    };*/

    ble_cnfg_ready_pin: ble_cnfg_ready_pin {
        compatible = "wulpus,gpio-signal";
        gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
        label = "BLE Configuration Ready Pin";
    };

    buttons {
        compatible = "gpio-keys";
        data_ready_pin: data_ready_pin {
            gpios = <&gpio0 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
            label = "Data Ready Pin";
        };
    };

    spi_ss_pin: spi_ss_pin {
        compatible = "wulpus,gpio-signal";
        gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
        label = "SPI SS Pin";
    };
};

&pinctrl {
    spi_master_default: spi_master_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 6)>,
                    <NRF_PSEL(SPIM_MISO, 1, 7)>,
                    <NRF_PSEL(SPIM_SCK, 1, 8)>;
        };
    };

    spi_master_sleep: spi_master_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 6)>,
                    <NRF_PSEL(SPIM_MISO, 1, 7)>,
                    <NRF_PSEL(SPIM_SCK, 1, 8)>;
            low-power-enable;
        };
    };
};

&uart20 {
    status = "disabled";
};

&spi20 {
    // The app drives SPIM20 directly with nrfx; keep Zephyr's SPI driver off
    // this node so it does not register the same interrupt.
    status = "disabled";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi_master_default>;
    pinctrl-1 = <&spi_master_sleep>;
    pinctrl-names = "default", "sleep";
};

// UART30 for console/shell/RTT (has default pinctrl)
&uart30 {
    status = "disabled";
    current-speed = <115200>;
};
